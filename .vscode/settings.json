{
    "[cpp]": {
        "editor.formatOnSave": true,
        "editor.indentSize": 2
    },
    "C_Cpp.clang_format_fallbackStyle": "Google",
    "C_Cpp.enhancedColorization": "enabled",
    "editor.minimap.enabled": false,
    "editor.folding": false,
    "editor.lineDecorationsWidth": 25,
    "editor.guides.indentation": false,
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-git-bash",
            "args": ["--init-file", ".vscode/init.sh"]
        }
    },
    "workbench.colorTheme": "Visual Studio Light - C++",
    "workbench.colorCustomizations": {
        "editorLineNumber.foreground": "#aaa",
        "editorLineNumber.activeForeground": "#666",
        "activityBar.background": "#f3f3f3",
        "activityBar.foreground": "#333",
        "activityBar.inactiveForeground":"#777",
        "activityBar.border":"#ccc",
        "editor.lineHighlightBackground": "#fafafa",
        "editor.lineHighlightBorder": "#0000"
    }
}
